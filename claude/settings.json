{
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "$ARGUMENTS is a git commit tool call. Extract the commit message from -m/-F flags or a heredoc. If there is no inline message (interactive editor commit), or the command is --amend with no new message, respond ok:true. Otherwise respond ok:true only if the subject line is Conventional Commits format: `type(scope)?: description` with type one of feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert, subject <=50 chars, imperative mood, no trailing period, lowercase description. If it fails, respond ok:false with a reason containing a corrected subject line and preserving any existing body.",
            "if": "Bash(git commit*)",
            "continueOnBlock": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cc-worktree-label.sh",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false,
    "caveman@caveman": false,
    "ponytail@ponytail": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "tui": "default",
  "theme": "dark",
  "editorMode": "vim",
  "teammateMode": "tmux",
  "autoMemoryEnabled": false
}
