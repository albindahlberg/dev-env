{
  "env": {
    "EDITOR": "nvim",
    "VISUAL": "nvim",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "permissions": {
    "defaultMode": "auto",
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/gcloud/**)",
      "Read(~/.kube/config)",
      "Read(~/.netrc)"
    ],
    "ask": [
      "Bash(kubectl *)",
      "Bash(oc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "prompt",
            "prompt": "$ARGUMENTS is a git commit tool call. Extract the commit message from -m/-F flags or a heredoc. If there is no inline message (interactive editor commit), or the command is --amend with no new message, respond ok:true. Otherwise respond ok:true only if the subject line is Conventional Commits format: `type(scope)?: description` with type one of feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert, subject <=50 chars, imperative mood, no trailing period, lowercase description. If it fails, respond ok:false with a reason containing a corrected subject line and preserving any existing body.",
            "if": "Bash(git commit*)",
            "continueOnBlock": true
          }
        ]
      },
      {
        "matcher": "Bash|Read|Grep|Glob|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/secret-guard.sh tool"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/herdr-agent-state.sh session",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/secret-guard.sh prompt"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "mattpocock-skills@claude-plugins-official": false,
    "caveman@caveman": false,
    "ponytail@ponytail": false
  },
  "extraKnownMarketplaces": {
    "caveman": {
      "source": {
        "source": "github",
        "repo": "JuliusBrussee/caveman"
      }
    },
    "ponytail": {
      "source": {
        "source": "github",
        "repo": "DietrichGebert/ponytail"
      }
    }
  },
  "tui": "default",
  "theme": "dark",
  "editorMode": "vim",
  "teammateMode": "tmux",
  "autoMemoryEnabled": false,
  "sandbox": {
    "filesystem": {
      "denyRead": [
        "**/.env",
        "**/.env.*",
        "**/*.pem",
        "**/*.key",
        "**/id_rsa*",
        "**/id_ed25519*",
        "~/.ssh/**",
        "~/.aws/**",
        "~/.config/gcloud/**",
        "~/.kube/config",
        "~/.netrc"
      ]
    }
  }
}
